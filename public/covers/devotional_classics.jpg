<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="30%" r="75%">
      <stop offset="0%" stop-color="#EAB308" stop-opacity="0.85" />
      <stop offset="60%" stop-color="#F59E0B" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#08090B" stop-opacity="1" />
    </radialGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0.7" />
    </linearGradient>
  </defs>

  <rect width="800" height="800" fill="#08090B" />
  <rect width="800" height="800" fill="url(#bgGlow)" />

  <!-- Vinyl Graphic -->
  <g transform="translate(400, 310)" opacity="0.95">
    <circle r="210" fill="#0D0E12" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
    <circle r="190" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
    <circle r="160" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="2" />
    <circle r="130" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
    <circle r="90" fill="#EAB308" fill-opacity="0.35" stroke="#F59E0B" stroke-width="3" />
    <circle r="30" fill="#0D0E12" />
    <circle r="8" fill="#ffffff" />
  </g>

  <!-- Bottom Details Glass Panel -->
  <rect x="40" y="520" width="720" height="230" rx="24" fill="url(#cardGrad)" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />

  <!-- Badge Pill -->
  <rect x="70" y="555" width="160" height="32" rx="16" fill="#EAB308" fill-opacity="0.2" stroke="#EAB308" stroke-width="1" />
  <text x="150" y="576" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="800" fill="#ffffff" letter-spacing="2" text-anchor="middle">SACRED & CLASSICAL</text>

  <!-- Title Text -->
  <text x="70" y="635" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="44" font-weight="900" fill="#ffffff" letter-spacing="-1">Devotional & Spiritual</text>
  <text x="70" y="675" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="20" font-weight="500" fill="rgba(255,255,255,0.7)">Annamayya, Sri Ramadasu, Shirdi Sai Divine Melodies</text>
  <text x="70" y="715" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#1ED760" letter-spacing="1.5">SONORA CURATED &bull; 50 TRACKS</text>
</svg>